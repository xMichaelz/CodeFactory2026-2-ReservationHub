        "url": "{{baseUrl}}/api/v1/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Consulta {{suffix}}\",\n  \"durationMinutes\": 60,\n  \"price\": 1000\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('serviceId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear horario 09-12 de mañana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{provToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/schedules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"{{dow}}\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"12:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear recurso (cantidad 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{provToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/resources",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sala {{suffix}}\",\n  \"resourceType\": \"SALA\",\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('resourceId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Asociar recurso al servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{provToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/services/{{serviceId}}/resources",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceIds\": [\n    \"{{resourceId}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "HU-11 Disponibilidad (09,10,11)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/services/{{serviceId}}/availability?from={{day}}&to={{day}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('3 huecos', () => pm.expect(pm.response.json().days[0].slots.length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
