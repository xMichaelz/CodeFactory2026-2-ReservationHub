      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('estado', () => pm.expect(pm.response.json().status).to.eql('CANCELLED_BY_CLIENT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "HU-15 Proveedor cancela sin motivo → 400",
      "request": {
