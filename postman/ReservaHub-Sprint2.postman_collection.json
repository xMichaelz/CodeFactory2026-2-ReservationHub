          },
          {
            "key": "Authorization",
            "value": "Bearer {{betoToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"date\": \"{{day}}\",\n  \"startTime\": \"09:00\"\n}"
        }
