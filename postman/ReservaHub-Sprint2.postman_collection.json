    {
      "name": "Lecturas",
      "item": [
        {
          "name": "Catálogo (Ana)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/catalog/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('incluye el servicio creado', () => pm.expect(pm.response.json().map(s => s.id)).to.include(pm.collectionVariables.get('serviceId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis reservas de Ana",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reservations/mine?from={{day}}&to={{day}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('2 reservas canceladas', () => { const r = pm.response.json(); pm.expect(r.length).to.eql(2); r.forEach(x => pm.expect(x.status).to.match(/^CANCELLED_/)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Agenda del proveedor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{provToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reservations/mine?from={{day}}&to={{day}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('2 reservas de su agenda', () => pm.expect(pm.response.json().length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rango de 32 días → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reservations/mine?from=2030-01-01&to=2030-02-01"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
