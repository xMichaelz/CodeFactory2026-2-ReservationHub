        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"date\": \"{{day}}\",\n  \"startTime\": \"09:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
