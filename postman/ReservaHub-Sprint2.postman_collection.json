{
  "info": {
    "name": "ReservaHub Sprint 2",
    "description": "Reservas HU-11 a HU-16: disponibilidad, reservar, doble reserva, reprogramar y cancelar. Carpeta «Lecturas»: catálogo, mis reservas y agenda. Ejecutar en orden con el Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "suffix",
      "value": "{{$timestamp}}"
    },
    {
      "key": "provToken",
      "value": ""
    },
    {
      "key": "anaToken",
      "value": ""
    },
    {
      "key": "betoToken",
      "value": ""
    },
    {
      "key": "anaId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "providerReservationId",
      "value": ""
    },
    {
      "key": "day",
      "value": ""
    },
    {
      "key": "dow",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparación (día de mañana)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=new Date(Date.now()+86400000+(-5*3600000));pm.collectionVariables.set('day', d.toISOString().slice(0,10));",
              "const w=['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];pm.collectionVariables.set('dow', w[d.getUTCDay()]);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Registrar proveedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/providers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"prov-{{suffix}}@example.com\",\n  \"password\": \"Secret123\",\n  \"firstName\": \"Luis\",\n  \"lastName\": \"Proveedor\",\n  \"businessName\": \"Clinica {{suffix}}\",\n  \"serviceType\": \"SALUD\",\n  \"description\": \"Consultorio\",\n  \"address\": \"Calle 1\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar cliente Ana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana-{{suffix}}@example.com\",\n  \"password\": \"Secret123\",\n  \"firstName\": \"Ana\",\n  \"lastName\": \"C\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('anaId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar cliente Beto",
