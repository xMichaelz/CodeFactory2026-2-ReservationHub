# ReservaHub local environment example
# Copy to .env and adjust values. Never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5433/reservahub
DB_USERNAME=reservahub
DB_PASSWORD=reservahub
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_EXPIRATION_MS=3600000
SERVER_PORT=8080
