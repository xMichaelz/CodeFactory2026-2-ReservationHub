# ReservaHub local environment example
# Copie a .env (no se commitea) y rellene los secretos. Sin ellos la API no arranca.

DB_URL=jdbc:postgresql://localhost:5433/reservahub
# Con el compose, la API usa reservahub_app (solo DML) y Flyway el dueño `reservahub` (ver DB_OWNER_*).
# Si corre la API a mano contra la BD del compose: DB_USERNAME=reservahub_app, DB_PASSWORD=<DB_APP_PASSWORD>.
DB_USERNAME=reservahub_app
# Contraseña del DUEÑO de la base de datos (POSTGRES_PASSWORD; ejecuta las migraciones)
DB_PASSWORD=
# Contraseña del usuario restringido de la API (reservahub_app, solo DML, sin DDL)
DB_APP_PASSWORD=
# Dueño para Flyway al correr la API a mano (el compose ya los pasa)
DB_OWNER_USERNAME=reservahub
DB_OWNER_PASSWORD=
# Genere con: openssl rand -base64 48   (mínimo 32 bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
SERVER_PORT=8080

# Swagger/OpenAPI solo en desarrollo (Postman/Swagger local). Por defecto apagado.
SWAGGER_ENABLED=false

# Orígenes CORS permitidos (separados por coma). Por defecto el front de desarrollo (Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Límite de peticiones (V-03). Valores por defecto; al pasarse la API responde 429 con Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTRATION_PER_HOUR=20
RATE_LIMIT_PROVIDER_REGISTRATION_PER_HOUR=3
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60
RATE_LIMIT_LOOKUP_PER_MINUTE=10
# Regex de las IP de proxies de confianza (solo a ellas se les cree X-Forwarded-For). Por defecto
# loopback y las redes privadas de Docker; normalmente no hace falta cambiarlo.
# RATE_LIMIT_TRUSTED_PROXIES=
