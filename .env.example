# ReservaHub local environment example
# Copie a .env (no se commitea) y rellene los secretos. Sin ellos la API no arranca.

DB_URL=jdbc:postgresql://localhost:5433/reservahub
DB_USERNAME=reservahub
# Contraseña propia de la base de datos
DB_PASSWORD=
# Genere con: openssl rand -base64 48   (mínimo 32 bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
SERVER_PORT=8080

# Swagger/OpenAPI solo en desarrollo (Postman/Swagger local). Por defecto apagado.
SWAGGER_ENABLED=false

# Orígenes CORS permitidos (separados por coma). Por defecto el front de desarrollo (Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173
